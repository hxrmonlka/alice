layout {

    focus-ring {
        active-color   "#da9ced"
        inactive-color "#211a23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#da9ced"
        inactive-color "#211a23"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#211a2370"
    }

    tab-indicator {
        active-color   "#da9ced"
        inactive-color "#9b11c6"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#da9ced80"
    }
}

recent-windows {
    highlight {
        active-color "#da9ced"
        urgent-color "#fd4663"
    }
}
