layout {

    focus-ring {
        active-color   "#e467ae"
        inactive-color "#291420"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e467ae"
        inactive-color "#291420"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#29142070"
    }

    tab-indicator {
        active-color   "#e467ae"
        inactive-color "#8d0c55"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e467ae80"
    }
}

recent-windows {
    highlight {
        active-color "#e467ae"
        urgent-color "#fd4663"
    }
}
